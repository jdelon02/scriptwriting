# Only the primary store is uploaded to. Other names are reserved for later use.
primary_vector_store_name=
vector_stores='[]'

# Direct NanoGPT embeddings; never put a real key in this example file.
NANOGPT_API_KEY=

# Base URL of litellm-pgvector (not the embedding proxy).
rag_base_url=
# Leave blank to reuse Hermes model.api_key; set if the vector service differs.
rag_api_key=

# Texts per synchronous embedding request (1–2048); CLI --batch-size overrides.
rag_batch_size=16
